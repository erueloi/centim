rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      // Requires a read, but ensures security
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isAuthenticated() && (request.auth.uid in groupData.memberIds);
    }

    // El currentGroupId de qui llegeix l'escriu ell mateix, així que NO prova
    // res: cal que TANT qui llegeix COM el perfil llegit siguin a memberIds
    // d'aquell grup. Si no, n'hi hauria prou d'apuntar-lo al grup d'una víctima.
    function sharesGroupWith(userId) {
      let groupId = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('currentGroupId', null);
      let memberIds = get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      return groupId is string
        && request.auth.uid in memberIds
        && userId in memberIds;
    }

    // Mateix format que genera l'app (6 caràcters A-Z0-9).
    function isValidInviteCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6}$');
    }

    // Les dades d'una llar no es poden moure ni injectar a una altra.
    function groupIdUnchanged() {
      return request.resource.data.groupId == resource.data.groupId;
    }

    // --- RULES ---

    // USERS: cadascú llegeix el seu perfil i el dels membres del seu grup
    // (selector de pagador), sempre per id: cap llistat de la col·lecció.
    match /users/{userId} {
      allow get: if isUser(userId) || (isAuthenticated() && sharesGroupWith(userId));
      allow write: if isUser(userId);
    }

    // BANK CONNECTIONS (Enable Banking): NOMÉS el propietari, i NOMÉS lectura
    // (per mostrar/escoltar l'estat de connexió). Les escriptures (sessió i
    // config de sync) es fan via Cloud Functions amb Admin SDK, així l'app mai
    // toca el session_id ni cap camp sensible.
    match /users/{userId}/bank_connections/{connId} {
      allow read: if isUser(userId);
    }

    // CREDENCIALS D'ENABLE BANKING DE CADA GRUP (clau privada xifrada) i
    // catàleg d'ASPSP en memòria cau: NOMÉS Cloud Functions (Admin SDK). Cap
    // client, ni l'owner del grup, les pot llegir ni escriure.
    match /bank_apps/{groupId} {
      allow read, write: if false;
    }
    match /aspsp_cache/{cacheId} {
      allow read, write: if false;
    }

    // GROUPS: només els membres el veuen, i ningú en pot llistar. Unir-se a una
    // llar només es pot fer amb el codi, via la Cloud Function joinGroupWithCode
    // (Admin SDK); aquí no hi ha cap camí per afegir-se a memberIds.
    match /groups/{groupId} {
      function sensitiveKeysTouched() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['memberIds', 'ownerId', 'inviteCode']);
      }

      // L'owner gestiona membres, propietat i codi, però sempre ha de quedar
      // dins del grup (no pot sortir mentre no traspassi la propietat).
      function isOwnerUpdate() {
        return request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId in request.resource.data.memberIds
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode'])
              || isValidInviteCode(request.resource.data.inviteCode));
      }

      // Un membre que no és l'owner es pot treure a si mateix i res més.
      function isSelfLeave() {
        return request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]);
      }

      allow get: if isAuthenticated() && request.auth.uid in resource.data.memberIds;

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && isValidInviteCode(request.resource.data.inviteCode);

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.memberIds
        && (!sensitiveKeysTouched() || isOwnerUpdate() || isSelfLeave());
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      // Create: User must be member of the target groupId
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);

      // Read/Delete: User must be member of the existing doc's groupId
      allow read, delete: if isAuthenticated() && isGroupMember(resource.data.groupId);
      // Update: a més, el groupId no pot canviar
      allow update: if isAuthenticated() && isGroupMember(resource.data.groupId) && groupIdUnchanged();
    }

    // BUDGETS
    match /budgets/{budgetId} {
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow read, delete: if isAuthenticated() && isGroupMember(resource.data.groupId);
      allow update: if isAuthenticated() && isGroupMember(resource.data.groupId) && groupIdUnchanged();
    }
    
    // CATEGORIES (subcollection under groups)
    match /groups/{groupId}/categories/{categoryId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // DEBT ACCOUNTS (subcollection under groups)
    match /groups/{groupId}/debt_accounts/{debtId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // ASSETS (subcollection under groups)
    match /groups/{groupId}/assets/{assetId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // TRANSFERS (subcollection under groups)
    match /groups/{groupId}/transfers/{transferId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // Índex d'idempotència de potes bancàries importades. No conté imports ni
    // conceptes: només la identitat bancària i el moviment/traspàs que la va
    // consumir.
    match /groups/{groupId}/bank_import_refs/{refId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // Ajustos manuals de reconciliació de guardioles.
    match /groups/{groupId}/balance_adjustments/{adjustmentId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // Regles explícites de suggeriment per a la importació.
    match /groups/{groupId}/import_rules/{ruleId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // BUDGET ENTRIES (subcollection under groups)
    match /groups/{groupId}/budget_entries/{entryId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }

    // CYCLE REPORTS (subcollection under groups)
    match /groups/{groupId}/cycle_reports/{cycleId} {
      allow read, write: if isAuthenticated() && isGroupMember(groupId);
    }


    // BILLING CYCLES
    match /billing_cycles/{cycleId} {
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow read, delete: if isAuthenticated() && isGroupMember(resource.data.groupId);
      allow update: if isAuthenticated() && isGroupMember(resource.data.groupId) && groupIdUnchanged();
    }

    // SAVINGS GOALS (root collection)
    match /savings_goals/{goalId} {
      // Create: user must be member of the group
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      // Read/Delete: user must be member of the group on the existing document
      allow read, delete: if isAuthenticated() && isGroupMember(resource.data.groupId);
      // Update: a més, el groupId no pot canviar
      allow update: if isAuthenticated() && isGroupMember(resource.data.groupId) && groupIdUnchanged();
    }
  }
}
